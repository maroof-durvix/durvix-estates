// DURVIX Estates — Prisma schema
// Adapted from the Node+Express+MySQL spec to Prisma/SQLite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  name       String
  phone      String
  // USER | AGENT | ADMIN
  role       String   @default("USER")
  // Layer 3: Programmatic Agent Ban — admin can flip this to true
  isBlocked  Boolean  @default(false)
  // Agent approval gate — new agents need admin approval
  isApproved Boolean  @default(true)
  agency     String?
  bio        String?
  avatar     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  properties   Property[]
  bookings     Booking[]  @relation("UserBookings")
  agentBookings Booking[]  @relation("AgentBookings")
}

model Property {
  id          String   @id @default(cuid())
  agentId     String
  title       String
  description String
  // Listing price in PKR (for BUY)
  price       Int
  // Monthly rent in PKR (for RENT listings); null when type=BUY
  rentPrice   Int?
  // BUY | RENT
  type        String   @default("BUY")
  city        String
  address     String
  area        String
  // Map pin coordinates (used by the split-screen SVG map)
  lat         Float
  lng         Float
  bedrooms    Int
  bathrooms   Int
  sizeSqft    Int
  // JSON array of image URLs
  images      String
  featured    Boolean  @default(false)
  // ACTIVE | INACTIVE
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agent     User      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  bookings  Booking[]
}

model Booking {
  id            String    @id @default(cuid())
  userId        String
  propertyId    String
  agentId       String
  // PENDING_TOKEN | CONFIRMED | CANCELLED | COMPLETED
  status        String    @default("PENDING_TOKEN")
  // Layer 2: Token Amount System (commitment fee)
  tokenAmount   Int       @default(5000)
  tokenPaidAt   DateTime?
  visitDate     String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User     @relation("UserBookings", fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agent    User     @relation("AgentBookings", fields: [agentId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  subject   String
  message   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}
